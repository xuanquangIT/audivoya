{
  "name": "realtime-dubbing-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "LicenseRef-Proprietary",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "check": "npm run build && node scripts/check.mjs && prettier --check . && npm run agents:check",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "test": "node --test scripts/agents/*.test.mjs scripts/agents/hooks/*.test.mjs scripts/worktree/*.test.mjs",
    "agents:sync": "node scripts/agents/sync.mjs",
    "agents:check": "node scripts/agents/sync.mjs --check",
    "wt": "node scripts/worktree/wt.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.9"
  }
}
